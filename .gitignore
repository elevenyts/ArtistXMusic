# ==========================================================
# .gitignore — ArtistMusic
# Made by Artist · GitHub: @elevenyts · ArtistBots
# ==========================================================

# ── Secrets & local config (NEVER commit these) ───────────
.env
.env.*
# Artist.env is the template (no real values) and must stay tracked
!Artist.env
*.session
*.session-journal
*.session.*
*.pem
*.key
cookies.txt
cookies/
*.cookies

# ── Runtime files created by the bot ──────────────────────
log.txt
log.txt.*
*.log
downloads/
cache/
raw_files/
*.mp3
*.mp4
*.m4a
*.webm
*.opus
*.ogg
*.wav
*.flac
*.mkv
*.mov

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environments ──────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Node (some tools use it for yt-dlp JS runtime) ────────
node_modules/

# ── Editors & OS junk ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Archives & backups ────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.bak
*.orig
*.rej
